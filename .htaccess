RewriteEngine On
Options -MultiViews

# Safety valve: this file belongs to the new public site only.
# If OVH ever maps the archive host here by mistake, do not redirect it to the main site.
RewriteCond %{HTTP_HOST} ^ancien\.cognac-esprit-organic\.com$ [NC]
RewriteRule ^ - [L]

# Redirect legacy duplicate URLs to their canonical destinations.
RewriteRule ^(.*/)?index\.html$ https://cognac-esprit-organic.com/$1 [R=301,L]
RewriteRule ^production\.html$ https://cognac-esprit-organic.com/demarche/ [R=301,L]
RewriteRule ^demarche-bio\.html$ https://cognac-esprit-organic.com/production/ [R=301,L]
RewriteRule ^leopold-et-fanny\.html$ https://cognac-esprit-organic.com/leopold-et-fanny/ [R=301,L]
RewriteRule ^produits/fondation-vs/?$ https://cognac-esprit-organic.com/produits/fondation-vs.html [R=301,L]
RewriteRule ^produits/conviction-vsop/?$ https://cognac-esprit-organic.com/produits/conviction-vsop.html [R=301,L]
RewriteRule ^produits/cohesion-napoleon/?$ https://cognac-esprit-organic.com/produits/cohesion-napoleon.html [R=301,L]
RewriteRule ^produits/transmission-xo/?$ https://cognac-esprit-organic.com/produits/transmission-xo.html [R=301,L]
RewriteRule ^produits/xxo/?$ https://cognac-esprit-organic.com/produits/xxo.html [R=301,L]
RewriteRule ^produits/single-cask/?$ https://cognac-esprit-organic.com/produits/single-cask.html [R=301,L]
RewriteRule ^produits/pineau/?$ https://cognac-esprit-organic.com/produits/pineau.html [R=301,L]
RewriteRule ^produits/pineau-rouge/?$ https://cognac-esprit-organic.com/produits/pineau-rouge.html [R=301,L]
RewriteRule ^assets/pdf/fiches-cavistes/cognac-esprit-organic-(fondation-vs|conviction-vsop|cohesion-napoleon|transmission-xo)-fiche-caviste\.pdf$ https://cognac-esprit-organic.com/assets/pdf/fiches-degustation/cognac-esprit-organic-$1-fiche-degustation.pdf [R=301,L]

# Force the canonical HTTPS host for the public website.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^cognac-esprit-organic\.com$ [NC]
RewriteRule ^ https://cognac-esprit-organic.com%{REQUEST_URI} [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpe?g|gif|svg|webp|avif|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html?|php|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
