Options -Indexes
<FilesMatch "^(?:(?:salon-(?:config|lib|newsletter)|newsletter-lib|nfc-lib)\.php|.*\.(?:sqlite|key|log|csv|lock))$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^salon-admin\.php$ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, max-age=0"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
